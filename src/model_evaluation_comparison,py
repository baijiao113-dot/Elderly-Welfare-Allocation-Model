import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# 解决 matplotlib 中文显示乱码及负号问题
plt.rcParams['font.sans-serif'] = ['SimHei']  # 指定默认字体
plt.rcParams['axes.unicode_minus'] = False    # 正常显示负号


# 1. 核心算法函数定义（数模规范公式实现）
def calculate_gini(income_array):
    """计算基尼系数 (Gini Coefficient)"""
    X = np.sort(np.asarray(income_array, dtype=float))
    n = len(X)
    mean = np.mean(X)
    if mean == 0:
        return 0
    abs_diff = np.abs(X[:, None] - X)
    gini = np.sum(abs_diff) / (2 * (n ** 2) * mean)
    return gini

def calculate_theil_elements(income, group_labels):
    """计算泰尔指数 (Theil-T Index) 并进行二分群体分解"""
    df_temp = pd.DataFrame({'income': income, 'group': group_labels})
    mu_total = df_temp['income'].mean()
    N_total = len(df_temp)
    if mu_total == 0:
        return 0, 0, 0
    
    # 总泰尔指数
    valid_idx = df_temp['income'] > 0
    T_total = np.sum((df_temp.loc[valid_idx, 'income'] / mu_total) * np.log(df_temp.loc[valid_idx, 'income'] / mu_total)) / N_total
    
    # 群体分解
    groups = df_temp.groupby('group')
    T_between, T_within = 0, 0
    
    for name, g in groups:
        n_g = len(g)
        mu_g = g['income'].mean()
        if mu_g == 0 or n_g == 0:
            continue
        s_g = n_g / N_total
        v_g = (n_g * mu_g) / (N_total * mu_total)
        T_between += v_g * np.log(mu_g / mu_total)
        g_valid = g['income'] > 0
        T_g = np.sum((g.loc[g_valid, 'income'] / mu_g) * np.log(g.loc[g_valid, 'income'] / mu_g)) / n_g
        T_within += v_g * T_g
        
    return T_total, T_between, T_within

# =============================================================================
# 2. 数据读取与多情景构建
# =============================================================================

file_path = "D:\math model\code\养老金补贴分配最终结果.xlsx"
df = pd.read_excel(file_path)

# 构建不同情景下的个人总收入（基础养老金 + 对应模型的补贴金）
df['总收入_补贴前'] = df['养老金']
df['总收入_λ0.5'] = df['养老金'] + df['补贴_λ0.5']
df['总收入_λ0.6'] = df['养老金'] + df['补贴_λ0.6']
df['总收入_λ0.7'] = df['养老金'] + df['补贴_λ0.7']

# 定义群体分类用于泰尔指数分解
df['群体分类'] = np.where(df['MPI_剥夺分数'] > 4, '高剥夺群体', '普通群体')

scenarios = {
    '补贴前状态(基础养老金)': '总收入_补贴前',
    'λ=0.5 方案': '总收入_λ0.5',
    'λ=0.6 方案': '总收入_λ0.6',
    'λ=0.7 方案(当前选择)': '总收入_λ0.7'
}

# 3. 多情景指标循环计算
results_list = []
for sc_name, col_name in scenarios.items():
    gini_val = calculate_gini(df[col_name].values)
    t_total, t_between, t_within = calculate_theil_elements(df[col_name].values, df['群体分类'].values)
    
    contrib_between = (t_between / t_total * 100) if t_total > 0 else 0
    contrib_within = (t_within / t_total * 100) if t_total > 0 else 0
    
    results_list.append({
        '政策分配方案': sc_name,
        '总体基尼系数 (Gini)': round(gini_val, 5),
        '总体泰尔指数 (Theil-T)': round(t_total, 5),
        '组间泰尔指数 (Between-Group)': round(t_between, 5),
        '组内泰尔指数 (Within-Group)': round(t_within, 5),
        '组间不平等贡献率 (%)': round(contrib_between, 2),
        '组内不平等贡献率 (%)': round(contrib_within, 2)
    })

eval_df = pd.DataFrame(results_list)

# 计算相较于基础养老金状态的相对改善率
base_gini = eval_df.loc[0, '总体基尼系数 (Gini)']
base_theil = eval_df.loc[0, '总体泰尔指数 (Theil-T)']

eval_df['基尼系数相对改善率 (%)'] = eval_df['总体基尼系数 (Gini)'].apply(lambda x: round((base_gini - x) / base_gini * 100, 2) if base_gini > 0 else 0)
eval_df['泰尔指数相对改善率 (%)'] = eval_df['总体泰尔指数 (Theil-T)'].apply(lambda x: round((base_theil - x) / base_theil * 100, 2) if base_theil > 0 else 0)

# =============================================================================
# 4. 导出新表格结果至 Excel 报表
# =============================================================================
output_excel = "养老金模型综合评价指标结果.xlsx"
eval_df.to_excel(output_excel, index=False)
print(f" 成功：新评价表格已成功写出至：'{output_excel}'")

