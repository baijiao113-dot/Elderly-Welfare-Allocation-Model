# 5. 修复冲突后的专属基尼系数演变趋势图绘制
# =============================================================================
plt.figure(figsize=(7.5, 5))

x_labels = eval_df['政策分配方案'].tolist()
gini_values = eval_df['总体基尼系数 (Gini)'].tolist()

# 核心安全修复：用数字标量 [0, 1, 2, 3] 作为真实 X 轴，彻底杜绝越界报错
x_numeric = np.arange(len(x_labels))
plt.plot(x_numeric, gini_values, marker='s', color='#1f77b4', linewidth=2.5, markersize=8)

# 将文字标签安全地贴在对应的数字刻度上
plt.xticks(x_numeric, x_labels, fontsize=9)

# 为每个数据点添加高亮数值标签
for i, val in enumerate(gini_values):
    plt.annotate(f"{val:.4f}", (x_numeric[i], gini_values[i]), textcoords="offset points", xytext=(0,12), ha='center', fontsize=10, weight='bold', color='#111111')

plt.title('图1：不同政策情景下全社会总收入基尼系数演变趋势', fontsize=12, fontweight='bold', pad=15)
plt.ylabel('基尼系数数值', fontsize=11)

# 动态保护 Y 轴范围，防止裁剪文本
plt.ylim(min(gini_values) - 0.015, max(gini_values) + 0.02)
plt.grid(True, linestyle='--', alpha=0.5)
